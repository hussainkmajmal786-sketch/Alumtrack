
# Worker build artefacts and local state
Alumtrack-main/worker/node_modules/
Alumtrack-main/worker/.wrangler/

# Migration intermediates. The snapshot .zip is kept (it is the backup);
# the generated SQL is reproducible from it via to-d1.py.
Alumtrack-main/migration/import*.sql
Alumtrack-main/migration/counts.txt
Alumtrack-main/migration/stmt-*.sql

# Convex database snapshot. Kept out of version control deliberately: it
# contains password hashes, session tokens and student emails, and this
# repository is public. The file lives on local disk and on Convex's own
# snapshot storage; to-d1.py regenerates the import SQL from it.
Alumtrack-main/migration/*.zip
